# --- Server ---
# Default localhost-only. Set AGENT_BIND_HOST=0.0.0.0 for LAN access.
AGENT_BIND_HOST=127.0.0.1
# Required when binding to non-localhost. Dashboard/WS use Bearer token or ?token=
AGENT_API_TOKEN=

# --- LLM seed (first run only; then edit llm.json in Dashboard) ---
LLM_BASE_URL=https://2api.store
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna

# --- Voice ---
# 0=subtitle only, 1=TTS after LLM reply
VOICE_TTS=0
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+20%

# --- ASR ---
ASR_ENGINE=vosk
VOSK_MODEL_PATH=backend/models/vosk-model-small-cn-0.22
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# --- Chat context ---
CHAT_CONTEXT_TURNS=6

# --- History ---
LLM_HISTORY_MAX_LINES=2000
LLM_HISTORY_QUERY_TAIL=5000

# --- Hook bridge (Cursor events) ---
# AGENT_DISPLAY_QUEUE=%USERPROFILE%/.cursor/hooks/event_queue.jsonl

# Security: never commit backend/.env, llm.json, wifi_profiles.json, or settings.json
