# LLM seed — used only when llm.json does not exist yet.
# After first backend start, edit profiles in Dashboard → LLM Config (writes llm.json).
# See README §5.4 for Base URL rules and provider examples.
LLM_BASE_URL=https://2api.store
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna

# Voice TTS (edge-tts / Windows SAPI). 1=on after LLM reply, 0=subtitle only.
VOICE_TTS=1

# Playback volume percent is stored in backend/settings.json (default 33, 100=original loudness).
